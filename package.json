{
  "name": "n8n-nodes-nibo-empresas",
  "version": "0.6.0",
  "description": "n8n community node for the Nibo Empresas API (Brazilian financial management platform)",
  "keywords": [
    "n8n-community-node-package",
    "nibo",
    "finance",
    "brazil"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alvarocastro-aecrio/n8n-nodes-nibo-empresas",
  "author": {
    "name": "Alvaro Castro",
    "email": "alvarocastrojr@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarocastro-aecrio/n8n-nodes-nibo-empresas.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lint:community": "ESLINT_USE_FLAT_CONFIG=true eslint --config eslint.community.mjs package.json nodes credentials",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "jest",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NiboEmpresasApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NiboEmpresas/NiboEmpresas.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.26.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^30.4.2",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
